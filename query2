{
  "size": 0,
  "aggs": {
    "nested_salary": {
      "nested": {
        "path": "salary"
      },
      "aggs": {
        "top_10_percent_salary": {
          "percentiles": {
            "field": "salary.amount",
            "percents": [90]
          }
        }
      }
    }
  }
}

