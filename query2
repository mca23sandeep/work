1. Employees who:
Joined in the last 6 months
AND
(Live in 'California' OR 'Texas' OR 'Florida')
AND
(Have a salary between $70,000 and $100,000 OR Have taken more than 3 sick leaves in the last year)


GET employees_aggregated_data2/_search
{
  "query": {
    "bool": {
      "must": [
        {
          "range": {
            "joinDate": {
              "gte": "now-3M/M", 
              "lte": "now/M"
            }
          }
        },
        {
          "nested": {
            "path": "addresses",
            "query": {
              "bool": {
                "should": [
                
                  { "match": { "addresses.state": "California" } },
                  { "match": { "addresses.state": "Texas" } },
				  { "match": { "addresses.state": "Florida" } }
                ],
               "minimum_should_match": 1
              }
            }
          }
        }
      
      ],
      "filter": [
        {
          "bool": {
            "should": [
              {
                "nested": {
                  "path": "salary",
                  "query": {
                    "range": {
                      "salary.amount": {
                        "gte": 80000,
                        "lte": 100000
                      }
                    }
                  }
                }
              },
              {
                "nested": {
                  "path": "leave_summary",
                  "query": {
                    "bool": {
                      "must": [
                        { "term": { "leave_summary.year": 2025 } },
                    { "range": { "leave_summary.sick_count": { "gt": 3 } } }

                    ]
                    }
                  }
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      ]
    }
  }
}


2. Employees who:
Have taken vacation leave in the last quarter
AND 
(Do NOT live in the 'USA' OR Live in 'Canada')
AND 
(Have a salary greater than $80,000 OR Have taken a sick leave longer than 7 days in the current year)



GET employees_aggregated_data2/_search
{
  "query": {
    "bool": {
      "must": [
        {
          "nested": {
            "path": "leaves",
            "query": {
              "bool": {
                "must": [
                  { "match": { "leaves.leave_type": "vacation" } },
                  {
                    "range": {
                      "leaves.leave_start_date": {
                       "gte": "now-3M/M",
                         "lt": "now/M"
                        
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "filter": [
        {
          "bool": {
            "should": [
              {
                "nested": {
                  "path": "addresses",
                  "query": {
                    "bool": {
                      "must_not": {
                        "match": { "addresses.country": "USA" }
                      }
                    }
                  }
                }
              },
              {
                "nested": {
                  "path": "addresses",
                  "query": {
                    "match": { "addresses.country": "Canada" }
                  }
                }
              }
            ],
            "minimum_should_match": 1
			
          }
        },
        {
          "bool": {
            "should": [
              {
                "nested": {
                  "path": "salary",
                  "query": {
                    "range": {
                      "salary.amount": {
                        "gt": 80000
                      }
                    }
                  }
                }
              },
              {
                "nested": {
                  "path": "leave_summary",
                  "query": {
                    "bool": {
                      "must": [
                         { "term": { "leave_summary.year": 2025 } },
                        { "range": { "leave_summary.sick_count": { "gt": 7 } } }
                      ]
                    }
                  }
                }
              }
            ],
            "minimum_should_match": 1
          }
        }
      ]
    }
  }
}


3. Employees who:
Joined between January 1st and March 31st of the current year
AND 
(Live in a city that starts with 'San' OR Live in a city that ends with 'ton')
AND 
(Have a salary within the top 10% of all employee salaries OR Have never taken any leave)

